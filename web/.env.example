# Copy this file to .env.local and fill in the values from your Firebase project settings
# (Firebase Console -> Project settings -> General -> Your apps -> SDK setup and configuration).
# .env.local is gitignored and should never be committed.
# Only Auth + Firestore fields are needed — this app targets the free Spark plan and doesn't use
# Cloud Storage or Cloud Functions (both now require the paid Blaze plan).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to point the app at the local Firebase Emulator Suite instead of a real
# project (run `firebase emulators:start --project demo-giftly` first). See README.md.
VITE_USE_EMULATORS=false
